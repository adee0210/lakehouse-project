# Postgres (Airflow metadata only)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow

# Airflow keys
AIRFLOW_FERNET_KEY=your_fernet_key_here
AIRFLOW_SECRET_KEY=your_secret_key_here

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# =====================================================
# Oracle Source  →  chỉ dùng cho tầng Bronze
# =====================================================
ORACLE_HOST=192.168.26.180
ORACLE_PORT=1521
ORACLE_SERVICE=DBPDB
ORACLE_USER=PG_MIS
ORACLE_PASSWORD=PG_MIS
# Nguồn dữ liệu Bronze: mock (dữ liệu giả lập) | oracle (đọc Oracle thật qua JDBC)
SOURCE_MODE=oracle
SPARK_CORES=4
SPARK_DRIVER_MEMORY=1600m
