# Postgres (Airflow metadata only)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow

# Airflow keys
AIRFLOW_FERNET_KEY=your_fernet_key_here
AIRFLOW_SECRET_KEY=your_secret_key_here

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# =====================================================
# Oracle Source  →  chỉ dùng cho tầng Bronze
# =====================================================
ORACLE_HOST=<điền>
ORACLE_PORT=1521
ORACLE_SERVICE=<điền>
ORACLE_USER=<điền>
ORACLE_PASSWORD=<điền>
# Nguồn dữ liệu Bronze: oracle (Oracle thật qua JDBC, cần VPN) | mock (giả lập offline)
SOURCE_MODE=oracle
SPARK_CORES=4
SPARK_DRIVER_MEMORY=1600m

# Tài nguyên theo máy (bỏ trống = mặc định cho máy Docker 4 GB). Ví dụ máy 16 GB:
# SPARK_CORES=6
# SPARK_DRIVER_MEMORY=4g
# SPARK_MEM_LIMIT=5g
# DBT_THREADS=4
# AIRFLOW_PARALLELISM=4
# AIRFLOW_MEM_LIMIT=2g
# Ngày nghiệp vụ mặc định cho Airflow (Variable etl_date)
ETL_DATE=2025-10-07
